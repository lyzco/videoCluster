# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work
*.data

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
bin/
dist/
.goreleaser/

# Develop tools
.vscode/
.idea/
*.swp

# Local agent guidance
agents.md

# Runtime configuration is environment-specific. Commit only config.example.yaml.
configs/*/config.yaml

# Generated code and API specifications are produced by CI and Release.
*.pb.go
*_grpc.pb.go
*_http.pb.go
wire_gen.go
openapi.yaml
openapi.json
swagger.json
